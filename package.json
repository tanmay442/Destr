{
  "name": "rag-knowledge-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:with-db": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:ci": "bash -c 'trap \"tsx scripts/teardown-test-db.ts\" EXIT INT TERM; tsx scripts/setup-test-db.ts && vitest run --reporter=dot'",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:check": "node scripts/check-drizzle-journal.mjs",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx packages/cli/src/index.ts seed",
    "setup-test-db": "tsx scripts/setup-test-db.ts",
    "teardown-test-db": "tsx scripts/teardown-test-db.ts",
    "typecheck": "tsc --noEmit",
    "configure": "tsx packages/cli/src/index.ts setup",
    "cli": "tsx packages/cli/src/index.ts",
    "arch": "dependency-cruiser --config .dependency-cruiser.cjs packages src config scripts",
    "gate": "bash -c \"pnpm test && pnpm typecheck && pnpm lint && pnpm arch\"",
    "gate:build": "pnpm gate && pnpm build",
    "eval": "tsx scripts/eval/run.ts",
    "backfill-blobs": "tsx scripts/backfill-blobs.ts",
    "chunks:preview": "tsx scripts/chunk-all-strategies.ts",
    "dev:db": "docker compose up -d db",
    "dev:ollama": "docker compose --profile ollama up -d ollama"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.90",
    "@ai-sdk/openai": "^3.0.82",
    "@ai-sdk/provider": "^3.0.13",
    "@ai-sdk/react": "^3.0.223",
    "@app/application": "workspace:*",
    "@app/domain": "workspace:*",
    "@app/infrastructure": "workspace:*",
    "@clerk/nextjs": "^7.5.15",
    "@langchain/textsplitters": "^1.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/qstash": "^2.11.1",
    "@upstash/redis": "^1.38.0",
    "ai": "^6.0.221",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.2"
}
