# Copy to .env.local and fill in real values.
# Defaults below boot against `docker compose up -d db` with zero
# external API keys (using Ollama for LLM).

# 1. Database
#    Uses local Docker Postgres. For Vercel, use your Neon URL.
#    NOTE: the password below must match the one in docker-compose.yml
#    (default `ragagent_local_dev`). If your Postgres volume predates the
#    password hardening it keeps the old `postgres` password — either recreate
#    the volume (`docker compose down -v && docker compose up -d db`) or keep
#    your existing DATABASE_URL value.
DATABASE_URL=postgres://postgres:ragagent_local_dev@localhost:5432/ragagent
#
#    PRODUCTION: use a least-privilege app role (e.g. `rag_app`), not the DB
#    owner. The app only needs SELECT/INSERT/UPDATE/DELETE. RLS is enabled on
#    all app tables with a policy granting the app role full access — every
#    other role is default-deny.
#    MIGRATION_DATABASE_URL is the DDL-capable URL (owner role) used by
#    `pnpm db:migrate` / drizzle-kit push. Migrations and the app must use
#    DIFFERENT roles so the app never holds DDL/role privileges.
# MIGRATION_DATABASE_URL=postgres://neondb_owner:...@.../neondb?sslmode=require
# NEXT_SKIP_MIGRATIONS=1         # skip `pnpm db:migrate` entirely (CI/builds without DB access)

# 2. Embedding provider: google | openai | ollama (default: google)
#    For zero-key local dev, use ollama:
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
#    For production (Google):
# EMBEDDING_PROVIDER=google
# AI_STUDIO_KEY=
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
#    Google is also a chat provider:
# CHAT_PROVIDER=google
# GOOGLE_CHAT_MODEL=gemini-2.5-flash
#    For OpenAI-compatible:
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_API_KEY=
# OPENAI_EMBEDDING_BASE_URL=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

EMBEDDING_DIMENSION=768

# 3. Chat provider: openai | google | ollama (default: openai)
#    For zero-key local dev, use ollama:
CHAT_PROVIDER=ollama
OLLAMA_CHAT_MODEL=gemma4:e2b
#    For production (OpenAI-compatible):
# CHAT_PROVIDER=openai
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=
# LLM_MODEL=custom-chat-model

# 4. Blob storage: filesystem | r2 | s3 (default: filesystem)
#    Production requires an explicit r2 or s3 provider. Filesystem is for local
#    development; in production it requires BLOB_FS_DIR on a persistent volume.
BLOB_STORAGE_PROVIDER=filesystem
BLOB_FS_DIR=./.blobs
# BLOB_GET_MAX_BYTES=50000000      # cap on blob-storage get() (avoids loading huge objects into memory)
# PDF_PARSE_MAX_BYTES=100000000    # reject PDFs larger than this before parsing
# PDF_PARSE_MAX_PAGES=5000         # reject PDFs with more pages than this
# PDF_PARSE_MAX_CHARS=50000000     # cap on extracted PDF text
# UPLOAD_CHUNKED_MAX_MD_BYTES=25000000   # cap on chunked-upload markdown field
# UPLOAD_CHUNKED_MAX_PDF_BYTES=100000000 # cap on chunked-upload companion PDF field
#    For production (Cloudflare R2):
# BLOB_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
#    For production (Amazon S3-compatible storage):
# BLOB_STORAGE_PROVIDER=s3
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT=                    # non-AWS endpoints (MinIO etc.); forces path-style addressing

# 5. Auth: clerk (only supported provider currently)
AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Only needed when Clerk is served behind a custom proxy domain (it then
# serves the JS bundle, API calls, and sign-in iframes from that origin).
# The CSP header in next.config.ts is derived from this automatically.
# Leave unset for Clerk dev mode / local Docker / free domains without a
# registered proxy — the CSP then falls back to the default Clerk frontend
# API domain only.
# CLERK_PROXY_URL=https://clerk.example.com
# NEXT_PUBLIC_CLERK_PROXY_URL=https://clerk.example.com

# 6. Rate limiting + query stats (optional, for multi-instance)
#    Without these, in-memory adapters are used (fine for local dev).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 7. Async ingest queue (optional, for large PDFs)
#    Without these, all uploads are synchronous.
#    QSTASH_TOKEN is read directly from the process environment; do not include
#    it in runtime config dumps or serialized configuration.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_INGEST_WORKER_URL=
# QSTASH_DLQ_URL=https://<app>/api/admin/ingest-dead-letter   # receives messages after retries exhaust (else silent loss); set in Vercel prod
# QSTASH_FAILURE_CALLBACK_URL=   # alternative failure callback when no DLQ is configured

# Public app URL used for CSRF origin checks and async worker URL fallback.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console site verification token (optional). Only set this for
# your own verified domain; when unset the verification meta tag is omitted.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 8. Neon project management (optional, for CI test branches)
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_TEST_BRANCH=dev-test
# NEON_TEST_BRANCH_TTL_HOURS=24
# NEON_TEST_BRANCH_FORCE=1        # emergency override for teardown safety

# 9. Seed script config (optional)
SEED_DOCS_DIR=./documents
SEED_USER_ID=seed-script
# SEED_LEGACY_SPLITTER=1          # use the legacy PDF splitter for seeding
# SEED_ALLOWED_ENV=1              # allow `pnpm cli seed` to run outside a guard-listed env
# UPLOAD_MD=                      # default Markdown source for `pnpm cli upload`

# 10. Admin bootstrap (optional)
#     Comma-separated list of emails.
ADMIN_EMAILS=
# CRON_SECRET=                   # bearer token for the scheduled crons: analytics rollup (02:00) + queue sweep (03:00)
#                                  GET requires this bearer token; POST is admin-authenticated.

# 11. Logging + startup validation (optional)
#     One of: error, warn, info, debug. Default: info.
LOG_LEVEL=info
# SKIP_ENV_VALIDATION=1          # skip startup env validation (CI, partial local envs)

# 12. Reranking (second-stage, Session 6) — 3-way feature flag
#     RERANKER_PROVIDER selects ONE of three modes. This is the single toggle
#     a person flips to choose which reranker runs (default = cosine).
#
#       cosine  -> the original pre-Session-6 bi-encoder ordering. NO reranker
#                  is loaded (zero native deps). The safe SERVERLESS default.
#       local   -> on-device Xenova cross-encoder, NO API key (needs native
#                  onnxruntime ~137 MB + a runtime model download).
#       cohere  -> hosted Cohere Rerank API (needs COHERE_API_KEY).
#
#     AUTO-FALLBACK: in every mode, if the chosen reranker FAILS to load or
#     call (Xenova on a read-only/over-limit serverless FS, Cohere with a
#     missing key or API error), searchChunks AUTOMATICALLY falls back to
#     cosine ordering. No crash.
#
#     Default (recommended for Vercel serverless): cosine.
RERANKER_PROVIDER=cosine
# CANDIDATE_POOL=30          # broad pool retrieved before reranking (local/cohere)
# RERANK_TOP_N=3             # final chunks returned to the LLM
#
#     --- Opt-in: on-device Xenova cross-encoder (local dev / Docker) ---
# RERANKER_PROVIDER=local
# LOCAL_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
#     On a read-only FS (Docker/serverless root) point the model cache at a
#     writable dir so the HuggingFace download does not fail:
# TRANSFORMERS_CACHE=/tmp/xenova-cache
#     On Vercel serverless `local` may exceed the function size limit or fail
#     on the read-only FS; if so it falls back to cosine automatically.
#
#     --- Opt-in: hosted Cohere Rerank API (serverless-native, no native deps) ---
# RERANKER_PROVIDER=cohere
# COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-english-v3.0

# 13. Agentic retrieval loop + guardrails (Session 8)
#     When on, chat retrieval runs: rewrite query -> hybrid/rerank retrieve ->
#     grade+drop irrelevant chunks -> retry once if weak -> generate ->
#     hallucination check. Out-of-domain refuses and offers createKnowledgeTicket.
AGENTIC_ENABLED=true
# CHAT_TURN_USE_CASE=1           # route chat through the application-layer use case instead of the inline handler
# GRADE_MODEL=                 # optional cheap model id for the rewrite/grade/hallucination calls
# OUT_OF_DOMAIN_THRESHOLD=0.3  # max-similarity below this with zero kept chunks -> refuse
# AGENT_STEP_BUDGET=8          # stepCountIs budget for the agentic loop
# AGENTIC_RETRIEVE_LIMIT=10    # candidate pool for the loop's re-retrieval
# AGENTIC_MAX_RETRIES=1        # rewrite+retry passes before falling back to a ticket

# 13b. Ingest and parent-child chunking
# CHUNKING_STRATEGY=document-aware  # document-aware | parent-child | recursive-adaptive | semantic
# INGEST_CHUNK_SIZE=800              # overlap is derived as 10% of this value
# MD_CHUNK_DELIMITER=---chunk---
# PARENT_CHUNK_SIZE=1800
# CHILD_CHUNK_SIZE=400
# PARENT_CHILD_MODE=parent           # parent | window
# PARENT_CHILD_WINDOW=2
# HYBRID_ENABLED=true
# RRF_K=60
# LEXICAL_WEIGHT=1
# CCH_ENABLED=true
# CCH_MODEL=

# 14. Answer cache + observability + eval (Session 10)
#     When on, first-turn query-keyed answers are cached in the SAME Upstash
#     Redis used for rate-limiting + query stats (no second connection).
#     Follow-up turns with conversation state are never cached.
ANSWER_CACHE_ENABLED=true
# ANSWER_CACHE_TTL_SEC=3600    # cache TTL (seconds)
# TRACE_ENABLED=true            # emit rag.* tracing spans via the logger
# EVAL_FAITHFULNESS_THRESHOLD=0.7  # pnpm eval CI gate (mean faithfulness)
# EVAL_REAL=1                    # keyed eval mode; never use this for mock CI

# 15. Runtime-editable settings + env-lock (Sessions 1-4)
#     Most operational settings (retrieval mode + knobs, agent persona/prompt,
#     out-of-scope list, and chunking for NEW uploads) are editable at runtime
#     via /admin/settings — no redeploy. They resolve with 4-layer precedence:
#       env-lock > DB override > config/app.config.ts > Zod schema default
#
#     APP_SETTINGS_LOCK pins comma-separated dot-paths read-only at read time
#     (the matching UI controls are disabled and the resolver ignores DB
#     overrides for them). Flat leaves and nested paths both work, e.g.:
# APP_SETTINGS_LOCK=retrievalMode,agentStepBudget,agentPersona.tone
#     Good candidates to pin: retrievalMode, agentStepBudget, rerankerProvider,
#     similarityThreshold. Leave blank for no pinning (fully UI-editable).
#
#     The following remain ENV-DRIVEN (no UI control, read at startup + redeploy):
#       INGEST_CHUNK_SIZE (chunking of re-ingested docs; overlap is derived)
#       CHUNKING_STRATEGY / EMBEDDING_PROVIDER / CHAT_PROVIDER / GRADE_MODEL
#       RERANKER_PROVIDER (see section 12)
