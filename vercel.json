{
  "framework": "nextjs",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm db:migrate; fi && pnpm exec next build",
  "installCommand": "pnpm install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/admin/analytics/rollup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/admin/queue/sweep",
      "schedule": "0 3 * * *"
    }
  ]
}
