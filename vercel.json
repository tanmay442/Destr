{
  "framework": "nextjs",
  "buildCommand": "pnpm exec next build",
  "installCommand": "pnpm install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/admin/analytics/rollup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/refresh-quality",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/admin/queue/sweep",
      "schedule": "0 3 * * *"
    }
  ]
}
